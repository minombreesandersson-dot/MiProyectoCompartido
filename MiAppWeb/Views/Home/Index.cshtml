@model List<MiAppWeb.Models.Producto>

@{
    ViewData["Title"] = "Inicio MVC";
}

<div class="container text-center mt-5">
    <h1 class="display-4 text-primary">Mis Productos desde SQLite</h1>
    <p class="lead">Proyecto creado en Linux listo para abrir en Visual Studio de Windows.</p>
    
    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>ID Interno</th>
                <th>Nombre del Artículo</th>
                <th>Precio Base</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>
                    <td>@producto.Nombre</td>
                    <td>$@producto.Precio</td>
                </tr>
            }
        </tbody>
    </table>
</div>
