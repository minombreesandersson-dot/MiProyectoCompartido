@model IEnumerable<SistemaAlquilerVehiculos.Models.Marca>

@{
    ViewData["Title"] = "Gestión de Marcas y Modelos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Marcas y Modelos</h2>
        <a asp-action="Create" class="btn btn-success">Registrar Nueva Marca</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Marca</th>
                <th>País de Origen</th>
                <th>Modelos Asociados</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var marca in Model)
            {
                <tr>
                    <td><strong>@marca.Nombre</strong></td>
                    <td>@marca.PaisOrigen</td>
                    <td>
                        @if (marca.Modelos.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var mod in marca.Modelos)
                                {
                                    <li>@mod.Nombre (@mod.Anio) - S/ @mod.PrecioDia/día</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Sin modelos registrados</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>